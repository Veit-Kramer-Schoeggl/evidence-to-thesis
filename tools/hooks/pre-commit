#!/bin/sh
# Wächter und Tests vor jedem Commit.
#
# Einmalig nach dem Klonen einrichten:   git config core.hooksPath tools/hooks
# Einmalig umgehen (bewusst!):          git commit --no-verify
#
# Erst prüft tools/pruefe.py Auswertungen, Register, Bestand und Verweise,
# dann prüfen die Tests in tests/ die Werkzeuge selbst.

set -e
wurzel="$(git rev-parse --show-toplevel)"

# Python finden: python3 auf macOS und Linux, unter Windows auch python oder py.
PY=""
for kandidat in python3 python py; do
    if command -v "$kandidat" >/dev/null 2>&1 \
        && "$kandidat" -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
        PY="$kandidat"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "Kein Python ab Version 3.9 gefunden. Anleitung: ablauf/0-einrichten.md" >&2
    exit 1
fi

"$PY" "$wurzel/tools/pruefe.py" --leise
cd "$wurzel" && "$PY" -m unittest discover -s tests -t . -q
